# 复制为 .env.development 后按需修改（npm run dev:mp-weixin 会加载）
# 正式构建 npm run build:mp-weixin 会加载 .env.production；若其中未配置基址，同样走 Mock、Network 无请求

# 测试 / 生产接口基址（不要末尾 /）
VITE_API_BASE_URL=http://47.107.171.124

VITE_API_TIMEOUT=15000

# 业务成功码：与后端 `{ code, msg, data }` 一致（当前后端成功为 200）
VITE_API_BIZ_CODE_SUCCESS=200

# 微信静默登录（默认已与后端对齐，可按环境覆盖）
# VITE_AUTH_WECHAT_SILENT_PATH=/api/auth/wechat/session

# 微信手机号授权登录（uuid + getPhoneNumber 的 code，默认已与后端对齐）
# VITE_AUTH_WECHAT_MOBILE_LOGIN_PATH=/api/auth/wechat/mobile-login
