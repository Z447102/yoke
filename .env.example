# 复制为 .env.development 后按需修改（npm run dev:mp-weixin 会加载）
# 正式构建 npm run build:mp-weixin 会加载 .env.production；若其中未配置基址，同样走 Mock、Network 无请求

# 接口契约见部署环境 OpenAPI（示例：https://baseapi.compoai.cn/v3/api-docs）

# 测试 / 生产接口基址（不要末尾 /）
VITE_API_BASE_URL=https://baseapi.compoai.cn

VITE_API_TIMEOUT=15000

# 腾讯位置服务 WebService Key，用于首页定位后的逆地址解析
# VITE_TENCENT_MAP_KEY=
# 开启 WebService 签名校验时必填；不要提交真实 Secret key
# VITE_TENCENT_MAP_SK=

# 业务成功码：与后端 `{ code, msg, data }` 一致（当前后端成功为 200）
VITE_API_BIZ_CODE_SUCCESS=200

# 一键成片视频模板：各发布平台在 tb_category 中的分类 id（与后端 platform 节点一致）
# VITE_PLATFORM_CATEGORY_DOUYIN=
# VITE_PLATFORM_CATEGORY_KUAISHOU=
# VITE_PLATFORM_CATEGORY_SHIPINHAO=
# VITE_PLATFORM_CATEGORY_XIAOHONGSHU=

# 可选：上面四项未配时，GET /api/member/video-templates 使用此 platformId（数字，单值兜底）
# VITE_VIDEO_TEMPLATE_DEFAULT_PLATFORM_ID=11

# 若以上均未配置，前端会传当前选中平台的 slug（如 douyin）作为 platformId；后端需支持或请改为配置数字 id。

# 微信静默登录（默认已与后端对齐，可按环境覆盖）
# VITE_AUTH_WECHAT_SILENT_PATH=/api/auth/wechat/session

# 微信手机号授权登录（uuid + getPhoneNumber 的 code，默认已与后端对齐）
# VITE_AUTH_WECHAT_MOBILE_LOGIN_PATH=/api/auth/wechat/mobile-login
